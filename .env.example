# Copy to .env and edit. Everything here is OPTIONAL: `docker compose up -d --build` works with no .env at all.
# The session secret is generated on first start, and your TorBox key, TMDB key and admin password are set in
# the admin page (stored encrypted), so none of them belong in this file.

# --- branding --------------------------------------------------------------------------------------------
# APP_NAME=Marquee        # the name shown on the site, tab and home-screen icon (applies on the next build)

# --- ports -------------------------------------------------------------------------------------------------
# HTTP_PORT=8080          # what friends open (via their invite link). The only port to expose to the internet.
# ADMIN_PORT=8081         # the admin panel. Keep it on your own network; never forward it on your router.

# --- the address friends use --------------------------------------------------------------------------------
# Used to build invite URLs. Can also be changed later in Admin -> Keys -> "Address friends use".
# PUBLIC_WATCH_URL=http://192.168.1.50:8080        # a LAN address, or
# PUBLIC_WATCH_URL=https://watch.example.com       # your tunnel / domain

# --- internal passwords --------------------------------------------------------------------------------------
# Only reachable inside the Docker network, but set your own random values on a real server
# (deploy.sh does this for you):  openssl rand -hex 16
# POSTGRES_PASSWORD=
# MEILI_MASTER_KEY=

# --- Cloudflare Tunnel (optional) ----------------------------------------------------------------------------
# Create a tunnel in the Cloudflare dashboard, route your hostname to  http://web:80 , paste the token here.
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# --- backups ---------------------------------------------------------------------------------------------------
# Nightly database dump + session secret, kept 14 days. Point this at a folder your backup tool already copies.
# BACKUP_DIR=./backups

# --- limits ----------------------------------------------------------------------------------------------------
# MAX_DEVICES=5           # devices per invite link

# --- torrent sources ---------------------------------------------------------------------------------------------
# Comma-separated Stremio addon base URLs. Defaults to Torrentio, TorrentsDB, Comet and StremThru Torz.
# Easier to change in Admin -> Sources.
# INDEXER_URLS=

# --- hostnames (only if you serve watch and admin on two real domains) ------------------------------------------
# WATCH_HOST=watch.example.com
# ADMIN_HOST=admin.example.com
# Cloudflare Access in front of ADMIN_HOST, replacing the password:
# CF_ACCESS_TEAM=
# CF_ACCESS_AUD=
# ADMIN_EMAIL=
